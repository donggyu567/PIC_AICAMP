# 프로젝트 루트의 .env로 복사해 사용한다. server.main이 루트 .env만 자동 로딩한다.
# 실제 키는 .env에 넣고 커밋하지 않는다. 기존 환경변수가 파일보다 우선한다.
ELEVENLABS_API_KEY=

# 발화 보정과 문맥 판단이 사용하는 서버 전용 키.
OPENAI_API_KEY=
# 기존 backend 보정용 설정이며 새 server의 통합 호출에서는 사용하지 않는다.
OPENAI_MODEL=gpt-5.6-luna
# 새 서버의 보정+문맥 판단 단일 호출 모델. 비어 있으면 두 작업을 생략하고 마스킹 입력으로 AI만 실행한다.
PIC_CONTEXT_MODEL=

# 임시 .pt로 실행하려면 checkpoint로 바꾸고 경로·버전을 채운다.
PIC_AI_MODE=disabled
PIC_AI_CHECKPOINT=
PIC_AI_MODEL_VERSION=
